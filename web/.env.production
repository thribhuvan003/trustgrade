# Read by `next build`. Committed on purpose: NEXT_PUBLIC_ values are compiled
# into the JavaScript every visitor downloads, so these addresses are public
# either way, and keeping them here means a deploy needs no dashboard entry.

# Always-on API: the board, the review queue, the AI drafts, the history.
NEXT_PUBLIC_API_URL=https://trustgrade.onrender.com/api

# Running code needs a Docker daemon, which no managed host gives a container,
# so grading alone goes to a machine that has one. If it is unreachable the site
# still works and the workspace says grading is off.
NEXT_PUBLIC_SANDBOX_API_URL=https://lifestyle-mentioned-quickly-household.trycloudflare.com/api
