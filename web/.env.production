# Read by `next build`. Committed on purpose: NEXT_PUBLIC_ values are compiled
# into the JavaScript every visitor downloads, so these addresses are public
# either way, and keeping them here means a deploy needs no dashboard entry.

# One always-on host serves everything, grading included: an EC2 instance with
# its own Docker daemon, which no managed platform gives a container, behind
# CloudFront for TLS. Both names point at it, so what a submission writes is
# what the history reads.
NEXT_PUBLIC_API_URL=https://d2un922tv2hjhv.cloudfront.net/api
NEXT_PUBLIC_SANDBOX_API_URL=https://d2un922tv2hjhv.cloudfront.net/api
