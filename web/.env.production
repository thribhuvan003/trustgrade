# Read by `next build`. Committed on purpose: NEXT_PUBLIC_ values are compiled
# into the JavaScript every visitor downloads, so these addresses are public
# either way, and keeping them here means a deploy needs no dashboard entry.

# One always-on host serves everything, grading included: a small EC2 instance
# with its own Docker daemon, which no managed platform gives a container. Both
# names point at it, so what a submission writes is what the history reads.
NEXT_PUBLIC_API_URL=https://api-surge-variance-blond.trycloudflare.com/api
NEXT_PUBLIC_SANDBOX_API_URL=https://api-surge-variance-blond.trycloudflare.com/api
