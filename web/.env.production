# Read by `next build`, so the deployed frontend knows where the API lives.
#
# Committed on purpose: NEXT_PUBLIC_ values are compiled into the JavaScript
# every visitor downloads, so the address is public either way, and keeping it
# here means a deployment needs no dashboard configuration.
#
# This points at a tunnel to a machine that has a Docker daemon, because code
# execution is the one thing a managed host cannot provide. If the tunnel is
# down the site still runs; only grading stops, and it says so.
NEXT_PUBLIC_API_URL=https://lifestyle-mentioned-quickly-household.trycloudflare.com/api
NEXT_PUBLIC_SANDBOX_AVAILABLE=true
