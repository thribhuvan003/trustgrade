# Read by `next build`, so the deployed frontend knows where the API lives.
#
# This is committed on purpose. NEXT_PUBLIC_ values are compiled into the
# JavaScript every visitor downloads, so the address is public either way, and
# keeping it here means a deployment needs no dashboard configuration.
#
# `next dev` does not read this file, so local work still talks to localhost:4000.
NEXT_PUBLIC_API_URL=https://trustgrade.onrender.com/api
