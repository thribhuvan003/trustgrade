DATABASE_URL=postgresql://trustgrade:trustgrade@localhost:5432/trustgrade

# Optional. With no key the doubt board and grading still work: drafts fall back
# to a message telling the student a teacher will answer directly.
# Defaults below are Groq's free tier. Any OpenAI-compatible endpoint works.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.6-27b
LLM_API_KEY=
